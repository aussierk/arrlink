# Local development environment (copy to .env)
CONFIG_DIR=./config
PORT=8270
LOG_LEVEL=info

# Cross-filesystem link fallback: skip (default) | copy | symlink
FS_FALLBACK=skip

# Auth: password and OIDC login can both be enabled at once — the login
# screen offers whichever are enabled. Both false (default) = open, no
# login (LAN-only assumption). Visit /login?form=true to bypass OIDC
# auto-login and reach the manual sign-in chooser.
AUTH_PASSWORD_ENABLED=false
# UI_USERNAME=admin          # default if unset
# UI_PASSWORD=change-me

AUTH_OIDC_ENABLED=false
# OIDC_ISSUER=https://<provider>/application/o/<app>/
# OIDC_CLIENT_ID=<client-id>
# OIDC_CLIENT_SECRET=<client-secret>
# OIDC_AUTO_LOGIN=true        # auto-redirect straight to the provider on load
#
# The redirect_uri sent to the provider (must exactly match one registered
# on the OIDC client) is APP_URL + /auth/oidc/callback. When APP_URL is
# unset it falls back to https://<first non-loopback TRUSTED_HOSTS entry>
# + that path, then to the request Host header (spoofable; logs a warning).
SESSION_TTL_H=12

# External base URL arrlink is reached at -- scheme + host + optional port +
# optional sub-path. Set this whenever OIDC is enabled without a
# Host-checking reverse proxy in front, or when the scheme/port/path the
# outside world uses differs from what arrlink sees. A sub-path assumes the
# proxy strips it before arrlink (there is no internal sub-path routing).
# APP_URL=https://arrlink.example.com
# APP_URL=https://apps.example.com/arrlink

# Trusted reverse proxy IP/CIDR, if one is in front of arrlink (Docker
# network address, not 127.0.0.1 -- a containerized proxy isn't localhost
# to this container). Only that peer's X-Forwarded-For/-Proto headers are
# honored; unset/default trusts none but localhost. See entrypoint.sh.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Comma-separated hostname(s) this app is allowed to think it's being
# reached as. Unset (default) = no restriction. Strongly recommended when
# arrlink is exposed without a Host-checking reverse proxy -- the first
# non-loopback entry is also the OIDC redirect_uri host (https) when APP_URL
# isn't set above.
# TRUSTED_HOSTS=arrlink.example.com
