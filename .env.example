# Local development environment (copy to .env)
CONFIG_DIR=./config
PORT=8270
LOG_LEVEL=info

# Cross-filesystem link fallback: skip (default) | copy | symlink
FS_FALLBACK=skip

# Auth: password and OIDC login can both be enabled at once — the login
# screen offers whichever are enabled. Both false (default) = open, no
# login (LAN-only assumption). Visit /login?form=true to bypass OIDC
# auto-login and reach the manual sign-in chooser.
AUTH_PASSWORD_ENABLED=false
# UI_USERNAME=admin          # default if unset
# UI_PASSWORD=change-me

AUTH_OIDC_ENABLED=false
# OIDC_ISSUER=https://<provider>/application/o/<app>/
# OIDC_CLIENT_ID=<client-id>
# OIDC_CLIENT_SECRET=<client-secret>
# OIDC_REDIRECT_URI=          # optional; default <origin>/api/auth/oidc/callback
# OIDC_AUTO_LOGIN=true        # auto-redirect straight to the provider on load
SESSION_TTL_H=12
