{
  "name": "arrlink-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.build.json && npm run copy-migrations",
    "copy-migrations": "node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^9.6.0",
    "pino-roll": "^3.1.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/proper-lockfile": "^4.1.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
